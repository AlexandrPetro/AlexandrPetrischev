---
import '../../styles/global.css';
import { localImages } from '../../data/images';

const base = import.meta.env.BASE_URL;
const yandexImage = (name: string) => {
  const path = localImages['yandex-crowd']?.[name];
  return path ? `${base}${path}` : '';
};
---

<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Яндекс крауд — Александр Петрищев</title>
</head>
<body>
  <header class="site-header">
    <a class="brand" href={base}>
      <span class="brand-mark"></span>
      <span>Alexandr Petrischev</span>
    </a>
    <a href={base} aria-label="Вернуться на главную">←</a>
  </header>

  <main class="yandex-page">
    <section class="yandex-hero">
      <div class="yandex-logo-placeholder" aria-label="Логотип проекта"></div>
      <h1>Моё тестовое от яндекс крауда</h1>
    </section>

    <div class="yandex-task-placeholder" aria-label="Техническое задание"></div>

    <section class="yandex-process">
      <div class="yandex-process-intro">
        <h2>Процесс я поделил на этапы:</h2>
        <ol>
          <li>Анализ сайтов-сервисов и мероприятий Яндекса</li>
        </ol>
      </div>

      <div class="yandex-frame yandex-frame-analis" style={`background-image:url("${yandexImage('img_analis')}")`} aria-label="Анализ сайтов-сервисов и мероприятий Яндекса"></div>

      <div class="yandex-conclusion">
        <p class="yandex-green">Вывод</p>
        <p>В сайтах-сервисах яндекса используется привычный (для яндекса) плашечный-интерфейсный дизайн. Для стилизации используются 3д, изометрия, гласоморфизм. Иллюстрации максимально просто и прямо дополняют смысл (диаграммы, иконки, графики). Но в сайтах посвящённых ивентам и мероприятиям используется больше креативных объектов, пиксельной графики, ярких плашек, размытия, паттернов и т.п. Следовательно для Ивент-мероприятий (сайт которого мы делаем по тз) допустимо и необходимо проявить больше креатива и добавить уникальной стилизации</p>
      </div>

      <ol start="2">
        <li>Анализ конкурентов</li>
      </ol>

      <div class="yandex-frame yandex-frame-analis2" style={`background-image:url("${yandexImage('img_analis2')}")`} aria-label="Анализ конкурентов"></div>

      <div class="yandex-conclusion">
        <p class="yandex-green">Вывод</p>
        <p>В сайтах мероприятий используется яркая стилистика, крупная типографика в заголовках, акцентные контрастные цвета, нестандартная сетка, и особый смыслообразующий декор. Все сайты имеют фестивальный дизайн, так как срок их жизни довольно короткий и задача привлечь больше внимания к мероприятию</p>
      </div>

      <div class="yandex-numbered-image">
        <ol start="3">
          <li>Формулировка концепции</li>
        </ol>
        <div class="yandex-frame yandex-frame-concept" style={`background-image:url("${yandexImage('img_concept')}")`} aria-label="Формулировка концепции"></div>
      </div>

      <div class="yandex-numbered-image">
        <ol start="4">
          <li>Подбор референсов</li>
        </ol>
        <div class="yandex-frame yandex-frame-ref" style={`background-image:url("${yandexImage('img_ref')}")`} aria-label="Подбор референсов"></div>
      </div>

      <div class="yandex-numbered-image">
        <ol start="5">
          <li>Прототип</li>
        </ol>
        <div class="yandex-frame yandex-frame-prot" style={`background-image:url("${yandexImage('img_prot')}")`} aria-label="Прототип"></div>
      </div>

      <div class="yandex-numbered-image yandex-final">
        <ol start="6">
          <li>Финальный макет</li>
        </ol>
        <div class="yandex-frame yandex-frame-design" style={`background-image:url("${yandexImage('img_design')}")`} aria-label="Финальный макет"></div>
      </div>
    </section>

    <a class="project-link" href={base}>← Вернуться к проектам</a>
  </main>
</body>
</html>

<style>
  .yandex-page {
    width: 800px;
    max-width: calc(100% - 48px);
    margin: 80px auto 64px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .yandex-hero {
    width: 802px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
  }

  .yandex-logo-placeholder {
    width: 110px;
    height: 110px;
    flex: 0 0 110px;
    background: #e3e3e3;
  }

  .yandex-hero h1 {
    width: 100%;
    font-size: 40px;
    line-height: 1;
    font-weight: 400;
    margin: 0;
  }

  .yandex-task-placeholder {
    width: 800px;
    max-width: 100%;
    height: 566px;
    margin-top: 68px;
    background: #e3e3e3;
  }

  .yandex-process {
    width: 802px;
    max-width: 100%;
    margin-top: 60px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .yandex-process-intro {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .yandex-process h2 {
    width: 100%;
    margin: 0;
    font-size: 20px;
    line-height: 1;
    font-weight: 600;
  }

  .yandex-process ol {
    width: 100%;
    margin: 0;
    padding-left: 24px;
    font-size: 16px;
    line-height: 24px;
  }

  .yandex-frame {
    width: 800px;
    max-width: 100%;
    background-color: #e3e3e3;
    background-position: top left;
    background-repeat: no-repeat;
    background-size: 100% auto;
    overflow: hidden;
  }

  .yandex-frame-analis {
    aspect-ratio: 800 / 239;
  }

  .yandex-frame-analis2 {
    aspect-ratio: 800 / 534;
  }

  .yandex-conclusion {
    width: 802px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    font-size: 16px;
    line-height: 24px;
  }

  .yandex-conclusion p {
    margin: 0;
  }

  .yandex-green {
    color: #34c759;
  }

  .yandex-numbered-image {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .yandex-final {
    margin-top: 0;
  }

  .yandex-frame-concept { aspect-ratio: 800 / 455.367; }
  .yandex-frame-ref { aspect-ratio: 800 / 241.28; }
  .yandex-frame-prot { aspect-ratio: 800 / 618.899; }
  .yandex-frame-design { aspect-ratio: 800 / 1916.111; }

  .project-link {
    margin-top: 60px;
    font-size: 16px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .yandex-page {
      max-width: calc(100% - 48px);
      margin-top: 56px;
    }

    .yandex-task-placeholder {
      height: auto;
      aspect-ratio: 800 / 566;
    }
  }

  @media (max-width: 600px) {
    .yandex-page {
      max-width: calc(100% - 32px);
      margin-top: 40px;
    }

    .yandex-hero h1 {
      font-size: 32px;
    }

    .yandex-task-placeholder {
      margin-top: 40px;
    }

    .yandex-process {
      margin-top: 40px;
    }
  }
</style>
