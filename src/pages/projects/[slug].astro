---
import '../../styles/global.css';

const projectMap = {
  '2b-agency': { title: '2b agency', subtitle: 'Моя роль в 2b' },
  'yandex-crowd': { title: 'Яндекс крауд', subtitle: 'Посмотреть процесс' },
  'tvoe-live': { title: 'Tvoe live', subtitle: 'Моя роль в Tvoe' },
  uprock: { title: 'Обучение в Uprock', subtitle: 'Проекты, сделанные с Uprock' },
  rassvetay: { title: 'Расцветай', subtitle: 'Что я делал в Расцветай' },
};

export function getStaticPaths() {
  return Object.keys(projectMap).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = projectMap[slug as keyof typeof projectMap];

const assetPath = 'https://www.figma.com/api/mcp/asset/471fbf6b-a964-449a-88f4-f03f221b9477';
const yandexAssetPath = 'https://www.figma.com/api/mcp/asset/4eab8378-6695-404d-b137-09629b1e94b1';
const tvoeAssetPath = 'https://www.figma.com/api/mcp/asset/97d7d5f4-c7e1-48aa-ac50-e0f7f23d5bfe';

const image = (name: string) => `${assetPath}/${name}.png`;
const yandexImage = (name: string) => `${yandexAssetPath}/${name}.png`;
const tvoeImage = (name: string) => `${tvoeAssetPath}/${name}.png`;
---

<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{project.title} — Александр Петрищев</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${import.meta.env.BASE_URL}`}><span class="brand-mark"></span><span>Alexandr Petrischev</span></a>
      <a href={`${import.meta.env.BASE_URL}`} aria-label="Вернуться на главную">←</a>
    </header>

    <main class="container case-study">
      {slug === '2b-agency' ? (
        <>
          <section class="section case-intro"><div class="hero-shape"></div><h1>Моя роль в 2b</h1><p class="intro">2b agency — digital-агентство полного цикла в сфере медицинского маркетинга. Я занимался UX/UI-дизайном сайтов и лендингов, прототипированием, UX-аудитами, адаптивами и подготовкой макетов для разработки.</p></section>
          <section class="section case-section"><h2>Кейс «Немецкий Имплантологический Центр»</h2><p>Работал над обновлением сайта клиники: информационной архитектурой, пользовательскими сценариями, страницами врачей, услуг, акций и портфолио.</p><img class="case-image" src={image('02851')} alt="Исходный дизайн сайта клиники" /><div class="image-stack"><img class="case-image" src={image('6f0b4')} alt="Финальный дизайн, часть 1" /><img class="case-image" src={image('0cb4a')} alt="Финальный дизайн, часть 2" /><img class="case-image" src={image('2cb9d')} alt="Финальный дизайн, часть 3" /></div></section>
          <section class="section case-section"><h2>Дополнительные страницы</h2><img class="case-image" src={image('0b767')} alt="Страница врача" /><img class="case-image" src={image('bd6e2')} alt="Раздел акций" /><img class="case-image" src={image('322df')} alt="Страница услуг" /><img class="case-image" src={image('410ff')} alt="Страница цены" /><img class="case-image" src={image('a948a')} alt="Выполненные работы" /><img class="case-image" src={image('0f5aa')} alt="Отдельный кейс" /></section>
          <section class="section case-section"><h2>Редизайн сайта агентства</h2><img class="case-image" src={image('95ebc')} alt="Исходный дизайн агентства" /><img class="case-image" src={image('098d6')} alt="Hero block агентства" /><img class="case-image" src={image('340f0')} alt="Блок кейсов агентства" /><div class="image-stack"><img class="case-image" src={image('76124')} alt="Финальный дизайн агентства, часть 1" /><img class="case-image" src={image('575c9')} alt="Финальный дизайн агентства, часть 2" /><img class="case-image" src={image('1b67c')} alt="Финальный дизайн агентства, часть 3" /></div></section>
        </>
      ) : slug === 'yandex-crowd' ? (
        <>
          <section class="section case-intro yandex-intro"><img class="yandex-logo" src={yandexImage('ceb49')} alt="Логотип Яндекса" /><h1>Моё тестовое от яндекс крауда</h1></section>
          <section class="section case-section"><img class="case-image" src={yandexImage('885f1')} alt="Техническое задание" /><h2>Процесс</h2><p>Анализ экосистемы Яндекса и конкурентов, формулировка концепции, подбор референсов, прототипирование и подготовка финального макета.</p><img class="case-image" src={yandexImage('5c1c0')} alt="Анализ Яндекса" /><img class="case-image" src={yandexImage('c6a39')} alt="Анализ конкурентов" /><img class="case-image" src={yandexImage('9eb52')} alt="Концепция" /><img class="case-image" src={yandexImage('fc9a7')} alt="Референсы" /><img class="case-image" src={yandexImage('89872')} alt="Прототип" /><img class="case-image" src={yandexImage('07b3a')} alt="Финальный макет" /><img class="case-image" src={yandexImage('2a45a')} alt="Мобильная версия" /></section>
        </>
      ) : slug === 'tvoe-live' ? (
        <>
          <section class="section case-intro tvoe-intro"><img class="tvoe-logo" src={`${tvoeAssetPath}/c412e.svg`} alt="Логотип Tvoe" /><h1>Задачи в Tvoe</h1><p class="intro">TVOE — мультплатформенный онлайн-кинотеатр, работающий по модели подписочного сервиса. Сервис доступен на веб-сайте, мобильных устройствах и Smart TV, а также предлагает тематические подборки, избранное и синхронизацию прогресса просмотра между устройствами.</p></section>
          <section class="section case-section"><div class="meta-grid"><div><span>Моя роль</span><strong>Дизайнер интерфейсов</strong></div><div><span>Команда</span><strong>Lead designer, frontend developers (3), backend developers (2), project manager, QA</strong></div><div><span>Дизайн система</span><strong>Была</strong></div></div></section>
          <section class="section case-section"><h2>Роль в команде</h2><p>Отвечал за развитие и поддержку интерфейсов веб-версии сервиса, участвовал в работе над мобильным и TV-приложениями, развивал компоненты дизайн-системы и обеспечивал адаптивность интерфейсов.</p><p>При ограниченном использовании продуктовой аналитики использовал конкурентный анализ как источник для поиска решений и формирования гипотез.</p></section>
          <section class="section case-section"><h2>Дизайн-система</h2><p>Поддерживал и дорабатывал существующую дизайн-систему, добавлял новые компоненты и актуализировал их под задачи продукта.</p><div class="image-stack"><img class="case-image" src={tvoeImage('b0c87')} alt="Компоненты дизайн-системы Tvoe" /><img class="case-image" src={tvoeImage('86ec0')} alt="Примеры компонентов Tvoe" /></div></section>
          <section class="section case-section"><h2>Веб-версия</h2><p>Участвовал в редизайне главной страницы, разработал экраны «Подборки» и отдельной подборки, проработал адаптивы для промежуточных разрешений и скелетон-состояния.</p><p class="caption">Старая версия веб-версии</p><div class="image-stack"><img class="case-image" src={tvoeImage('95388')} alt="Старая версия Tvoe, часть 1" /><img class="case-image" src={tvoeImage('7980a')} alt="Старая версия Tvoe, часть 2" /><img class="case-image" src={tvoeImage('1cede')} alt="Старая версия Tvoe, часть 3" /></div><p class="caption">Редизайн веб-версии</p><p>Добавил блок «Сторис», обновил промо-баннер, добавил коллекции, переработал карточки в жанрах и обновил размеры, отступы и скругления существующих элементов.</p><div class="image-stack"><img class="case-image" src={tvoeImage('0ebba')} alt="Редизайн Tvoe, часть 1" /><img class="case-image" src={tvoeImage('9da5d')} alt="Редизайн Tvoe, часть 2" /><img class="case-image" src={tvoeImage('bba69')} alt="Редизайн Tvoe, часть 3" /><img class="case-image" src={tvoeImage('d7d98')} alt="Редизайн Tvoe, часть 4" /><img class="case-image" src={tvoeImage('04fed')} alt="Редизайн Tvoe, часть 5" /></div></section>
        </>
      ) : (
        <section class="section project-detail"><h1>{project.title}</h1><h2>{project.subtitle}</h2><div class="detail-placeholder">Материалы этого проекта добавим следующим этапом.</div></section>
      )}

      <a class="project-link" href={`${import.meta.env.BASE_URL}`}>← Вернуться к проектам</a>
    </main>
  </body>
</html>

<style>
  .case-study { display: flex; flex-direction: column; gap: 40px; }
  .case-intro, .case-section { display: flex; flex-direction: column; gap: 20px; }
  .case-intro { gap: 40px; }
  .case-section p, .case-section li { font-size: 16px; line-height: 24px; }
  .caption { font-size: 14px !important; line-height: 24px; color: #808080; }
  .case-image { width: 100%; height: auto; display: block; border: 1px solid #e3e3e3; border-radius: 20px; }
  .image-stack { display: flex; flex-direction: column; gap: 20px; }
  .yandex-intro, .tvoe-intro { align-items: flex-start; }
  .yandex-logo, .tvoe-logo { width: 110px; height: auto; }
  .meta-grid { display: flex; flex-direction: column; gap: 20px; }
  .meta-grid div { display: flex; flex-direction: column; gap: 8px; }
  .meta-grid span { color: #808080; font-size: 16px; }
  .meta-grid strong { font-size: 20px; font-weight: 400; line-height: 24px; }
  .detail-placeholder { min-height: 400px; background: #f8f8f8; display: grid; place-items: center; text-align: center; padding: 32px; color: rgba(0,0,0,.5); }
  @media (max-width: 600px) { .case-section p { font-size: 15px; line-height: 22px; } .case-image { border-radius: 12px; } .meta-grid strong { font-size: 17px; } }
</style>
