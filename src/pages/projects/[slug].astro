---
import '../../styles/global.css';

const projectMap = {
  '2b-agency': { title: '2b agency', subtitle: 'Что я делал в 2b', text: 'Описание проекта и мой вклад в работу над продуктом.' },
  'yandex-crowd': { title: 'Яндекс крауд', subtitle: 'Посмотреть процесс', text: 'Дизайн лендинга конференции Yandex pet day и мобильный адаптив.' },
  'tvoe-live': { title: 'Tvoe live', subtitle: 'Моя роль в Tvoe', text: 'Работа над интерфейсами онлайн-кинотеатра.' },
  uprock: { title: 'Обучение в Uprock', subtitle: 'Проекты, сделанные с Uprock', text: 'Проекты в рамках курса Middle UX/UI designer.' },
  rassvetay: { title: 'Расцветай', subtitle: 'Что я делал в Расцветай', text: 'Графический и web-дизайн для девелоперской компании.' },
};

const { slug } = Astro.params;
const project = projectMap[slug as keyof typeof projectMap] ?? { title: 'Проект', subtitle: 'Описание проекта', text: 'Информация о проекте появится здесь.' };
---

<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{project.title} — Александр Петрищев</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><span class="brand-mark"></span><span>User name</span></a>
      <a href="/" aria-label="Вернуться на главную">←</a>
    </header>
    <main class="container">
      <section class="section project-detail">
        <h1>{project.title}</h1>
        <p class="intro">{project.text}</p>
        <h2>{project.subtitle}</h2>
        <div class="detail-placeholder">Материалы проекта добавим по макету Figma.</div>
        <a class="project-link" href="/">← Вернуться к проектам</a>
      </section>
    </main>
  </body>
</html>

<style>
  .project-detail { display: flex; flex-direction: column; gap: 40px; }
  .detail-placeholder { min-height: 400px; background: #f8f8f8; display: grid; place-items: center; text-align: center; padding: 32px; color: rgba(0,0,0,.5); }
</style>
