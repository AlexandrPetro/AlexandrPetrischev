---
import '../../styles/global.css';
import { imageSources, pngUrl, imageUrl } from '../../data/images';

const projectMap = {
  '2b-agency': { title: '2b agency', subtitle: 'Моя роль в 2b' },
  'yandex-crowd': { title: 'Яндекс крауд', subtitle: 'Посмотреть процесс' },
  'tvoe-live': { title: 'Tvoe live', subtitle: 'Моя роль в Tvoe' },
  uprock: { title: 'Обучение в Uprock', subtitle: 'Проекты, сделанные с Uprock' },
  rassvetay: { title: 'Расцветай', subtitle: 'Что я делал в Расцветай' },
};

export function getStaticPaths() {
  return Object.keys(projectMap).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = projectMap[slug as keyof typeof projectMap];

const image = (name: string) => pngUrl(imageSources['2b-agency'].base, name);
const yandexImage = (name: string) => pngUrl(imageSources['yandex-crowd'].base, name);
const tvoeImage = (name: string) => pngUrl(imageSources['tvoe-live'].base, name);
const uprockImage = (name: string) => pngUrl(imageSources.uprock.base, name);
const rassvetayImage = (name: string) => pngUrl(imageSources.rassvetay.base, name);
const tvoeLogo = imageUrl(imageSources['tvoe-live'].base, imageSources['tvoe-live'].files.logo);
const uprockLogo = imageUrl(imageSources.uprock.base, imageSources.uprock.files.logo);
const rassvetayLogo = imageUrl(imageSources.rassvetay.base, imageSources.rassvetay.files.logo);

const uprockCorporate = imageSources.uprock.files.corporate.slice(0, 4);
const uprockCorporateMore = imageSources.uprock.files.corporate.slice(4);
const uprockShop = imageSources.uprock.files.shop;
const uprockMobile = imageSources.uprock.files.mobile;
---

<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{project.title} — Александр Петрищев</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${import.meta.env.BASE_URL}`}><span class="brand-mark"></span><span>Alexandr Petrischev</span></a>
      <a href={`${import.meta.env.BASE_URL}`} aria-label="Вернуться на главную">←</a>
    </header>

    <main class="container case-study">
      {slug === '2b-agency' ? (
        <>
          <section class="section case-intro"><div class="hero-shape"></div><h1>Моя роль в 2b</h1><p class="intro">2b agency — digital-агентство полного цикла в сфере медицинского маркетинга. Я занимался UX/UI-дизайном сайтов и лендингов, прототипированием, UX-аудитами, адаптивами и подготовкой макетов для разработки.</p></section>
          <section class="section case-section"><h2>Кейс «Немецкий Имплантологический Центр»</h2><p>Работал над обновлением сайта клиники: информационной архитектурой, пользовательскими сценариями, страницами врачей, услуг, акций и портфолио.</p><img class="case-image" src={image('02851')} alt="Исходный дизайн сайта клиники" /><div class="image-stack"><img class="case-image" src={image('6f0b4')} alt="Финальный дизайн, часть 1" /><img class="case-image" src={image('0cb4a')} alt="Финальный дизайн, часть 2" /><img class="case-image" src={image('2cb9d')} alt="Финальный дизайн, часть 3" /></div></section>
          <section class="section case-section"><h2>Дополнительные страницы</h2>{['0b767','bd6e2','322df','410ff','a948a','0f5aa'].map((name) => <img class="case-image" src={image(name)} alt="Страница проекта 2b" />)}</section>
          <section class="section case-section"><h2>Редизайн сайта агентства</h2>{['95ebc','098d6','340f0','76124','575c9','1b67c'].map((name) => <img class="case-image" src={image(name)} alt="Редизайн сайта агентства" />)}</section>
        </>
      ) : slug === 'yandex-crowd' ? (
        <>
          <section class="section case-intro yandex-intro"><img class="yandex-logo" src={yandexImage('ceb49')} alt="Логотип Яндекса" /><h1>Моё тестовое от яндекс крауда</h1></section>
          <section class="section case-section"><img class="case-image" src={yandexImage('885f1')} alt="Техническое задание" /><h2>Процесс</h2><p>Анализ экосистемы Яндекса и конкурентов, формулировка концепции, подбор референсов, прототипирование и подготовка финального макета.</p>{['5c1c0','c6a39','9eb52','fc9a7','89872','07b3a','2a45a'].map((name) => <img class="case-image" src={yandexImage(name)} alt="Этап проекта Яндекс" />)}</section>
        </>
      ) : slug === 'tvoe-live' ? (
        <>
          <section class="section case-intro tvoe-intro"><img class="tvoe-logo" src={tvoeLogo} alt="Логотип Tvoe" /><h1>Задачи в Tvoe</h1><p class="intro">TVOE — мультплатформенный онлайн-кинотеатр, работающий по модели подписочного сервиса. Сервис доступен на веб-сайте, мобильных устройствах и Smart TV.</p></section>
          <section class="section case-section"><div class="meta-grid"><div><span>Моя роль</span><strong>Дизайнер интерфейсов</strong></div><div><span>Команда</span><strong>Lead designer, frontend developers, backend developers, project manager, QA</strong></div><div><span>Дизайн-система</span><strong>Была</strong></div></div></section>
          <section class="section case-section"><h2>Роль в команде</h2><p>Отвечал за развитие и поддержку интерфейсов веб-версии сервиса, участвовал в работе над мобильным и TV-приложениями, развивал компоненты дизайн-системы и обеспечивал адаптивность интерфейсов.</p></section>
          <section class="section case-section"><h2>Дизайн-система</h2><p>Поддерживал и дорабатывал существующую дизайн-систему, добавлял новые компоненты и актуализировал их под задачи продукта.</p>{['b0c87','86ec0'].map((name) => <img class="case-image" src={tvoeImage(name)} alt="Компоненты дизайн-системы Tvoe" />)}</section>
          <section class="section case-section"><h2>Веб-версия</h2><p>Участвовал в редизайне главной страницы, разработал экраны «Подборки» и отдельной подборки, проработал адаптивы и скелетон-состояния.</p>{['95388','7980a','1cede','0ebba','9da5d','bba69','d7d98','04fed'].map((name) => <img class="case-image" src={tvoeImage(name)} alt="Экран Tvoe" />)}</section>
        </>
      ) : slug === 'uprock' ? (
        <>
          <section class="section case-intro uprock-intro"><img class="uprock-logo" src={uprockLogo} alt="Логотип Uprock" /><h1>Курс Middle UX/UI designer</h1><p class="intro">Uprock — образовательная платформа и дизайн-студия. Обучение длилось 1,5 года и было направлено на развитие практических навыков UX/UI-дизайна.</p></section>
          <section class="section case-section"><div class="meta-grid"><div><span>Длительность</span><strong>1,5 года</strong></div><div><span>Формат</span><strong>Онлайн-обучение с обратной связью, направленное на практические навыки</strong></div><div><span>Модули</span><strong>Корпоративный сайт<br />Интернет-магазин<br />Мобильное приложение</strong></div><div><span>Что входило в программу</span><strong>Исследования пользователей, конкурентный анализ, User Flow, CJM, информационная архитектура, UI-кит, адаптивность, Auto Layout, переменные, стили и токены.</strong></div></div></section>
          <section class="section case-section"><h2>Корпоративные сайты</h2>{[...uprockCorporate, ...uprockCorporateMore].map((name) => <img class="case-image" src={uprockImage(name)} alt="Корпоративный сайт, проект Uprock" />)}</section>
          <section class="section case-section"><h2>Интернет-магазин</h2>{uprockShop.map((name) => <img class="case-image" src={uprockImage(name)} alt="Интернет-магазин, проект Uprock" />)}</section>
          <section class="section case-section"><h2>Мобильное приложение</h2>{uprockMobile.map((name) => <img class="case-image" src={uprockImage(name)} alt="Мобильное приложение, проект Uprock" />)}</section>
        </>
      ) : slug === 'rassvetay' ? (
        <>
          <section class="section case-intro rassvetay-intro"><img class="rassvetay-logo" src={rassvetayLogo} alt="Логотип Расцветай" /><h1>Что я делал в Расцветай</h1><p class="intro">Группа компаний «Расцветай» — девелоперская компания из Новосибирска, специализирующаяся на строительстве жилой и коммерческой недвижимости. Компания входит в число крупнейших застройщиков Новосибирской области, а также реализует проекты в нескольких регионах России.</p><p class="intro">По данным ЕРЗ.РФ на ноябрь 2025 года, компания занимала первое место в Новосибирской области по объёму текущего строительства.</p></section>
          <section class="section case-section"><h2>Мои обязанности</h2><ul><li>Дизайн рекламных материалов</li><li>Разработка и поддержка фирменного стиля</li><li>Дизайн социальных сетей</li><li>Дизайн материалов для офисов продаж</li><li>Печатная и полиграфическая продукция</li><li>Дизайн сайта</li><li>Взаимодействие с отделами компании</li><li>Подготовка материалов для мероприятий и PR</li><li>Работа с визуальными материалами проектов</li><li>Работа с подрядчиками и производством</li></ul></section>
          <section class="section case-section"><h2>Рекламные материалы</h2>{['e0ce5','a9a84'].map((name) => <img class="case-image" src={rassvetayImage(name)} alt="Рекламные материалы Расцветай" />)}</section>
          <section class="section case-section"><h2>Проект «Лофт-наука»</h2>{['67862','451a4'].map((name) => <img class="case-image" src={rassvetayImage(name)} alt="Проект Лофт-наука" />)}</section>
          <section class="section case-section"><h2>Концепт ребрендинга</h2><img class="case-image" src={rassvetayImage('92ade')} alt="Концепт ребрендинга Расцветай" /></section>
          <section class="section case-section"><h2>Редизайн сайта</h2><p class="caption">Исходный вариант</p><img class="case-image" src={rassvetayImage('899a0')} alt="Исходный вариант сайта Расцветай" /><p class="caption">Редизайн</p>{['071a0','b1edf','67604','ca4d2','19f07'].map((name) => <img class="case-image" src={rassvetayImage(name)} alt="Редизайн сайта Расцветай" />)}</section>
        </>
      ) : (
        <section class="section project-detail"><h1>{project.title}</h1><h2>{project.subtitle}</h2><div class="detail-placeholder">Материалы этого проекта добавим следующим этапом.</div></section>
      )}

      <a class="project-link" href={`${import.meta.env.BASE_URL}`}>← Вернуться к проектам</a>
    </main>
  </body>
</html>

<style>
  .case-study { display: flex; flex-direction: column; gap: 40px; }
  .case-intro, .case-section { display: flex; flex-direction: column; gap: 20px; }
  .case-intro { gap: 40px; }
  .case-section p, .case-section li { font-size: 16px; line-height: 24px; }
  .caption { font-size: 14px !important; line-height: 24px; color: #808080; }
  .case-image { width: 100%; height: auto; display: block; border: 1px solid #e3e3e3; border-radius: 20px; }
  .image-stack { display: flex; flex-direction: column; gap: 20px; }
  .yandex-intro, .tvoe-intro, .uprock-intro, .rassvetay-intro { align-items: flex-start; }
  .yandex-logo, .tvoe-logo, .uprock-logo, .rassvetay-logo { width: 110px; height: auto; }
  .meta-grid { display: flex; flex-direction: column; gap: 20px; }
  .meta-grid div { display: flex; flex-direction: column; gap: 8px; }
  .meta-grid span { color: #808080; font-size: 16px; }
  .meta-grid strong { font-size: 20px; font-weight: 400; line-height: 24px; }
  .case-section ul { margin: 0; padding-left: 24px; }
  .detail-placeholder { min-height: 400px; background: #f8f8f8; display: grid; place-items: center; text-align: center; padding: 32px; color: rgba(0,0,0,.5); }
  @media (max-width: 600px) { .case-section p, .case-section li { font-size: 15px; line-height: 22px; } .case-image { border-radius: 12px; } .meta-grid strong { font-size: 17px; } }
</style>
