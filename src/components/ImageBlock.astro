---
import { localImages } from '../data/images';

interface Props {
  key: string;
  alt: string;
  project?: string;
  height: number;
  rounded?: boolean;
}

const { key, alt, height, rounded = false, project = '2b-agency' } = Astro.props;
const base = import.meta.env.BASE_URL;
const src = localImages[project]?.[key] || null;
const classes = rounded ? 'placeholder rounded' : 'placeholder';
---
<div class={classes} style={`--placeholder-height:${height}px`}>
  {src && <img src={`${base}${src}`} alt={alt} />}
</div>
