---
import { localImages } from '../../data/images';

interface Props {
  key: string;
  alt: string;
  height: number;
  rounded?: boolean;
}

const { key, alt, height, rounded = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const src = localImages['2b-agency']?.[key];
const classes = rounded ? 'placeholder rounded' : 'placeholder';
---
<div class={classes} style={`--placeholder-height:${height}px`}>
  {src && <img src={`${base}${src}`} alt={alt} />}
</div>
